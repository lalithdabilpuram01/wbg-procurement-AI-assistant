# Lakebase connection settings for the pgvector POC. Copy to lakebase.local.env (git-ignored) and fill in.
# No password here: a 60-minute OAuth credential is generated at run time via the Databricks CLI.
LAKEBASE_HOST=<endpoint-id>.database.<region>.cloud.databricks.com
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_USER=<your Databricks login, e.g. name@example.com>
LAKEBASE_ENDPOINT=projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>
LAKEBASE_DATABRICKS_PROFILE=wbg-databricks-free
LAKEBASE_SSLMODE=require
