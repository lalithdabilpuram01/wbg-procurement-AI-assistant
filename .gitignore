# Local environment files with real secrets – never commit. Only the blank template .env.example is tracked.
.env
.env.*
!.env.example
*.env
*.env.bak
*.env.backup
*.secrets
secrets/

# Logfire SDK local data/credentials directory
.logfire/

# Isolated Python environment for the Structured Data MCP server (recreate with structured_agent/mcp_env/setup_mcp_env.sh)
.venv-structured-mcp/

__pycache__/
*.pyc
.pytest_cache/

# Large public bulk files – reproducible via discovery/scripts (see MANIFEST.jsonl for checksums)
research/discovery/data_cache/*
!research/discovery/data_cache/MANIFEST.jsonl

# Downloaded document files – reproducible via s04/s04b/p05; checksums in samples/MANIFEST.jsonl
research/discovery/samples/documents/files/*.pdf
research/discovery/samples/documents/files/*.txt
research/discovery/samples/documents/pp_files/
*.part
research/discovery/samples/documents/isr_series/*.txt

# Cohort-bounded Bronze inputs – reproducible via discovery/scripts/b01_extract_bronze_inputs.py
# (checksums in databricks_upload/bronze_inputs/_manifest/)
data/bronze_inputs/*
!data/bronze_inputs/_manifest/

# Staged country-level reference inputs – byte copies of discovery/country_indicators/raw and samples/indicators
data/ref_bronze_inputs/*
!data/ref_bronze_inputs/_manifest/

# D-14 (approved 2026-10-23): raw procurement-notice text containing personal contact data – never commit.
# Reproducible via discovery/scripts/s03_procnotices.py and discovery/project_deep_dive/d01_fetch_two_projects.py;
# checksums in discovery/samples/MANIFEST.jsonl and discovery/project_deep_dive/raw/MANIFEST.json.
research/discovery/samples/procnotices/*.jsonl.gz
research/discovery/project_deep_dive/raw/*/procnotices_*.json

# ---------------------------------------------------------------------------------------------------------------
# Repository scope (2026-10-26): code, configuration, lock files, docs/reports, small manifests and the frozen ML
# models are tracked. Environments, downloaded documents, extracted text, caches and run outputs stay local only:
# they are reproducible from the pipelines and live in Unity Catalog / Lakebase.
# ---------------------------------------------------------------------------------------------------------------
# Python environments and tool caches (rebuilt from requirements / uv.lock)
.venv/
.mypy_cache/
.DS_Store
.*.lock

# Never commit restricted document content
**/restricted/

# Downloaded documents and extracted text
*.pdf
*.txt
!requirements*.txt
!**/requirements*.txt
data/rag_scope/**/plan_text/
research/rag_module1_discovery/**/plan_text/
research/discovery/project_deep_dive/raw/*/docs_text/

# Derived data: corpora, indexes, embeddings, tabular extracts
*.npy
*.npz
*.parquet
*.gz
rag/corpus_v3/processed/
rag/retrieval/index_cache/
rag/embedding_cache/experimental_store/
rag/embedding_cache/staging/
rag/embedding_cache/releases/
rag/release_v3/results/embedding_manifest.json

# Run outputs, logs and experiment scratch (final results are summarised in docs/reports and ml/reports)
**/runs/
*.log
ml/eda/
data/rag_scope/**/plan_coverage/PLAN_ACTIVITIES.csv
research/rag_module1_discovery/**/plan_coverage/PLAN_ACTIVITIES.csv
data/rag_scope/**/plan_coverage/CONTRACT_PLAN_EVIDENCE_LINKS.csv
research/rag_module1_discovery/**/plan_coverage/CONTRACT_PLAN_EVIDENCE_LINKS.csv
**/fetch_log.jsonl
**/access_log.jsonl
research/discovery/country_indicators/raw/
research/discovery/project_deep_dive/raw/*/

# Ingestion inbox (ingest/): dropped files, processed/quarantined copies and the ledger stay local; folder READMEs are tracked
ingestion_inbox/**
!ingestion_inbox/*/
!ingestion_inbox/*/README.md
!ingestion_inbox/README.md
ingestion_inbox/_processed/
ingestion_inbox/_quarantine/
ingestion_inbox/_ledger/

# Demo upload files made by `uv run wbg-etl-seed` (real World Bank rows; reproducible)
demo/structured/*.csv
