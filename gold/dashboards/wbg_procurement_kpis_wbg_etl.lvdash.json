{
 "datasets": [
  {
   "name": "overview",
   "displayName": "Overview",
   "queryLines": [
    "SELECT * FROM wbg_etl.wbg_gold.vw_kpi_overview"
   ]
  },
  {
   "name": "awards",
   "displayName": "Contract awards",
   "queryLines": [
    "SELECT * FROM wbg_etl.wbg_gold.vw_kpi_contract_awards"
   ]
  },
  {
   "name": "notices",
   "displayName": "Notice activity",
   "queryLines": [
    "SELECT * FROM wbg_etl.wbg_gold.vw_kpi_notice_activity"
   ]
  },
  {
   "name": "windows",
   "displayName": "Bid windows by notice type",
   "queryLines": [
    "SELECT * FROM wbg_etl.wbg_gold.vw_kpi_response_windows WHERE grouping_level = 'type'"
   ]
  },
  {
   "name": "countries",
   "displayName": "Top countries by contract value",
   "queryLines": [
    "SELECT * FROM wbg_etl.wbg_gold.vw_kpi_country_comparison WHERE geography_type = 'single_country' ORDER BY contract_award_value_usd DESC LIMIT 15"
   ]
  },
  {
   "name": "income",
   "displayName": "Projects by income group",
   "queryLines": [
    "SELECT coalesce(latest_income_group, 'Not classified') AS income_group, projects FROM wbg_etl.wbg_gold.vw_kpi_country_comparison WHERE geography_type = 'single_country'"
   ]
  },
  {
   "name": "sizes",
   "displayName": "Contract size by category",
   "queryLines": [
    "SELECT * FROM wbg_etl.wbg_gold.vw_kpi_contract_value_distribution WHERE grouping_level = 'category'"
   ]
  },
  {
   "name": "financing",
   "displayName": "Financing instruments",
   "queryLines": [
    "SELECT * FROM wbg_etl.wbg_gold.vw_kpi_financing_instruments"
   ]
  }
 ],
 "pages": [
  {
   "name": "overview",
   "displayName": "Overview",
   "pageType": "PAGE_TYPE_CANVAS",
   "layout": [
    {
     "widget": {
      "name": "title",
      "multilineTextboxSpec": {
       "lines": [
        "## WBG procurement KPIs",
        "2,000-project PoC cohort. Source: the Gold layer (`wbg_etl.wbg_gold`), read-only. Contract values are exact sums of contract awards; bid windows are published windows, not tender durations."
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 6,
      "height": 2
     }
    },
    {
     "widget": {
      "name": "projects",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "overview",
         "fields": [
          {
           "name": "total_projects",
           "expression": "`total_projects`"
          }
         ],
         "disaggregated": true
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "total_projects",
         "displayName": "Projects"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Projects"
       }
      }
     },
     "position": {
      "x": 0,
      "y": 2,
      "width": 1,
      "height": 2
     }
    },
