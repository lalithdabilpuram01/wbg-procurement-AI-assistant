# WBG Procurement Intelligence: required settings.
# Copy to .env (git-ignored), fill in, then check with: uv run python -m app_config.check_env
# Every other setting has a safe default (see HOW_TO_RUN.md). Lakebase settings are in infrastructure/lakebase_poc/.

# Portkey service API key (secret). Provider keys stay in Portkey: do not add ANTHROPIC_API_KEY here.
PORTKEY_API_KEY=
# Claude model in Portkey Model Catalog form: @<provider slug>/<model slug>
PORTKEY_CLAUDE_MODEL=
