# Phase 1 discovery settings. No credentials are needed: every source is public.
# Copy to .env (git-ignored) to override defaults.

WB_SEARCH_API_BASE=https://search.worldbank.org/api/v2
WB_FONE_API_BASE=https://datacatalogapi.worldbank.org/dexapps/fone/api/apiservice
WB_FONE_FILES_BASE=https://financesonefiles.worldbank.org/f-one
WB_INDICATORS_API_BASE=https://api.worldbank.org/v2

WB_HTTP_TIMEOUT_S=90
WB_HTTP_MAX_RETRIES=5
WB_HTTP_BACKOFF_BASE_S=2.0
WB_HTTP_POLITE_DELAY_S=0.5

WB_SAMPLE_SEED=20261020
WB_CONTRACT_SAMPLE_PER_FY=125
WB_CLUSTER_PROJECTS=300
WB_DOC_META_PER_TYPE=150
WB_PDFS_PER_TYPE=3
WB_PP_SAMPLE=40

# Bulk files (~390 MB total) go to discovery/data_cache (git-ignored).
WB_ALLOW_BULK_DOWNLOADS=true

# ==========================================
# WBG Procurement Intelligence - local development environment template
# Copy to .env and fill in locally. Never commit .env. Check: python -m app_config.check_env
# ==========================================

# PORTKEY AI GATEWAY
# Service API key (secret, required). Do NOT add ANTHROPIC_API_KEY or XAI_API_KEY: provider keys live in Portkey integrations.
PORTKEY_API_KEY=
# Claude model in Portkey Model Catalog form, e.g. @wbg-anthropic/<model slug exactly as listed in the Model Catalog>.
# Sent WITHOUT a Config, so the Claude+Grok fallback Config is not used until Grok is verified (see docs/llm_resilience_architecture.md).
PORTKEY_CLAUDE_MODEL=

# LOGFIRE OBSERVABILITY (Pydantic Logfire SDK, installed in .venv-structured-mcp)
# Export is OFF unless LOGFIRE_SEND_TO_LOGFIRE=true; the token is never used while export is off.
LOGFIRE_TOKEN=
LOGFIRE_SEND_TO_LOGFIRE=false
LOGFIRE_SERVICE_NAME=wbg-procurement-intelligence

# LIVE LLM CALLS: never store WBG_ALLOW_LIVE_LLM_CALLS here. Set it only on the command line of an approved run
# (e.g. WBG_ALLOW_LIVE_LLM_CALLS=true ... --confirm-live-call); app_config/check_env.py flags it if found in .env.

# DATABRICKS DEVELOPMENT SAFETY
# false = the execution gateway refuses the write-capable owner credential (default deny).
WBG_ALLOW_DEV_OWNER_CREDENTIALS=false

# EXISTING COMPONENT SETTINGS (optional overrides; the code defaults below are used when unset)
# WBG_REGISTRY_DSN=postgresql://wbg_registry_reader@localhost:5432/wbg_structured_registry
# WBG_REGISTRY_ADMIN_DSN=postgresql://wbg_registry_admin@localhost:5432/wbg_structured_registry
# WBG_DATABRICKS_PROFILE=wbg-databricks-free
# WBG_SQL_MAX_ROWS=1000
# WBG_SQL_TIMEOUT_SECONDS=60
# WBG_AUDIT_LOG=structured_agent/runs/audit_events.jsonl
# WBG_MCP_PRINCIPAL and WBG_MCP_WORKSPACE are set per MCP server deployment, not here (see structured_agent/README.md).
